# Copy this file to .env.local and fill in your Supabase project details.
# Get these from: https://supabase.com/dashboard → Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Canonical origin used for password-reset redirect links.
# Set this to your production domain (e.g. https://mybookshelf.app).
# Falls back to window.location.origin when not set (fine for local dev).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
